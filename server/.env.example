# Local PostgreSQL (v13+ — gen_random_uuid() is built in from 13 onward)
# Create the database first:  createdb dealwise
# Two logins. The OWNER runs migrations and creates the app login; the APP login is
# what the server uses day to day. The app login must not be a superuser, or
# row-level security (companies can't see each other's data) is skipped.
MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealwise"
# after `npm run db:app-role`:
DATABASE_URL="postgresql://dealwise_app:<APP_DB_PASSWORD>@localhost:5432/dealwise"
APP_DB_PASSWORD="choose-a-long-random-password"
# APP_DB_USER=dealwise_app

# For a hosted DB instead, append ?sslmode=require and SSL is enabled automatically:
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="http://localhost:5173"

# Production: NODE_ENV=production enables secure cookies + trust proxy and makes the
# server refuse to start with a weak JWT_SECRET (min 32 chars) or a localhost CLIENT_URL.
# NODE_ENV=production
# CORS_ORIGINS="https://app.example.com"     # defaults to CLIENT_URL
# DB_SSL_ALLOW_SELF_SIGNED=true              # only for providers with self-signed certs
# ALLOW_DESTRUCTIVE_SEED=true                # db:seed refuses in production without this

# Set MAIL_ENABLED=false to print reset/portal links to the console instead of
# sending real email — use this while testing so runs don't spam a real inbox.
# MAIL_ENABLED=false

# Optional SMTP — without it, reset/portal links are printed to the server console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="no-reply@dealwise.app"

# Optional Google sign-in. Create an OAuth client (type "Web application") in Google
# Cloud Console -> APIs & Services -> Credentials, and add this authorised redirect URI:
#   <CLIENT_URL>/api/auth/google/callback      e.g. http://localhost:5173/api/auth/google/callback
# Without both values the "Continue with Google" button is hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
